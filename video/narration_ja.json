[
 {
  "id": "title_00",
  "seg": "title",
  "t": 0.0,
  "hold": "end",
  "tone": "drama",
  "text": "自発的な点火は、どこから始まるのか。培養した神経細胞とハエの脳、ふたつの神経ネットワークに同じ問題を出してみました。"
 },
 {
  "id": "intro_00",
  "seg": "intro",
  "t": 0.0,
  "hold": "end",
  "tone": "normal",
  "text": "神経細胞は、外からなにも入力がなくても勝手に発火します。自発活動です。"
 },
 {
  "id": "intro_01",
  "seg": "intro",
  "t": 3.4,
  "hold": "end",
  "tone": "normal",
  "text": "お皿で育てた神経細胞では、ときどきネットワーク全体がいっせいに発火します。これがバーストです。"
 },
 {
  "id": "intro_02",
  "seg": "intro",
  "t": 6.8,
  "hold": "end",
  "tone": "drama",
  "text": "その火は、どこで点くのでしょうか？　なにがその場所を決め、暴走までは、あとどれくらいなのでしょうか？"
 },
 {
  "id": "round1_00",
  "seg": "round1",
  "t": 0.0,
  "hold": "end",
  "tone": "hot",
  "text": "ラウンド、ワン。培養神経。バーストは、電極チップのどこから点火するのか。"
 },
 {
  "id": "chip_00",
  "seg": "chip",
  "t": 0.0,
  "hold": "end",
  "tone": "normal",
  "text": "電極チップの上で育てた、ラットの神経細胞です。光る点は、その場所での発火を表します。"
 },
 {
  "id": "chip_01",
  "seg": "chip",
  "t": 1.1,
  "hold": "end",
  "tone": "hot",
  "text": "まず、この一か所が強く光ります。てんかです。"
 },
 {
  "id": "chip_02",
  "seg": "chip",
  "t": 3.95,
  "hold": "end",
  "tone": "normal",
  "text": "そこから火は、まわりへ燃え広がります。"
 },
 {
  "id": "chip_03",
  "seg": "chip",
  "t": 7.45,
  "hold": "end",
  "tone": "whisper",
  "text": "そして、しばらく静かになります。"
 },
 {
  "id": "chip_04",
  "seg": "chip",
  "t": 8.45,
  "hold": "end",
  "tone": "drama",
  "text": "ところが次のバーストも、まったく同じ場所から点火しました。"
 },
 {
  "id": "maps_00",
  "seg": "maps",
  "t": 0.0,
  "hold": "end",
  "tone": "normal",
  "text": "同じ培養を何日も記録して、点火した場所を地図にしてみます。"
 },
 {
  "id": "maps_01",
  "seg": "maps",
  "t": 3.6,
  "hold": "end",
  "tone": "joy",
  "text": "すると、同じホットスポットが日をまたいで何度も現れました。七つの培養すべてで同じ傾向です。"
 },
 {
  "id": "maps_02",
  "seg": "maps",
  "t": 7.2,
  "hold": "end",
  "tone": "normal",
  "text": "別の場所になる日もありますが、また戻ってきます。"
 },
 {
  "id": "predict_00",
  "seg": "predict",
  "t": 0.0,
  "hold": "end",
  "tone": "drama",
  "text": "点火の場所を言い当てたのは、なにか。それは、よく発火する場所ではありませんでした。"
 },
 {
  "id": "predict_01",
  "seg": "predict",
  "t": 3.0,
  "hold": "end",
  "tone": "normal",
  "text": "手がかりは、バーストの合間にありました。いっしょに発火しやすい細胞のまとまり、その最も強いパターンが、点火の場所をある程度予測していたのです。"
 },
 {
  "id": "predict_02",
  "seg": "predict",
  "t": 6.6,
  "hold": "end",
  "tone": "drama",
  "text": "そしてこのネットワークは、暴走のほんの一歩手前にいました。分岐比はおよそ、れいてんきゅうきゅうです。"
 },
 {
  "id": "round2_00",
  "seg": "round2",
  "t": 0.0,
  "hold": "end",
  "tone": "hot",
  "text": "ラウンド、ツー。ハエの脳。同じ条件のハエの脳では、どこから点火するのか。"
 },
 {
  "id": "fly_setup_00",
  "seg": "fly_setup",
  "t": 0.0,
  "hold": "end",
  "tone": "normal",
  "text": "ハエの脳の全配線図をもとに、およそ十四万個のニューロンからなる脳を、まるごとコンピューターの中で動かします。"
 },
 {
  "id": "fly_setup_01",
  "seg": "fly_setup",
  "t": 3.2,
  "hold": "end",
  "tone": "normal",
  "text": "条件は培養と同じ。弱いランダムなノイズと、使うと疲れるシナプス。入力はそれだけです。"
 },
 {
  "id": "gain_00",
  "seg": "gain",
  "t": 0.0,
  "hold": "end",
  "tone": "normal",
  "text": "シナプスがふつうの強さだと、ハエの脳はバーストを起こしません。"
 },
 {
  "id": "gain_01",
  "seg": "gain",
  "t": 4.4,
  "hold": "end",
  "tone": "hot",
  "text": "ところがシナプスを二倍に強めると、バーストが起こり始め、強めるほど増えていきます。"
 },
 {
  "id": "slowmo1_00",
  "seg": "slowmo1",
  "t": 0.0,
  "hold": "start",
  "tone": "calm",
  "text": "バースト直前の、れいてんいち秒間を、ゆっくり再生してみましょう。"
 },
 {
  "id": "slowmo1_01",
  "seg": "slowmo1",
  "t": 1.367,
  "hold": "end",
  "tone": "drama",
  "text": "最初に光るのは、においの中枢、しょっかくようです。"
 },
 {
  "id": "slowmo1_02",
  "seg": "slowmo1",
  "t": 2.867,
  "hold": "end",
  "tone": "normal",
  "text": "左右のしょっかくようにいる、ごく少数の細胞が、脳全体より先に発火していました。"
 },
 {
  "id": "slowmo1_03",
  "seg": "slowmo1",
  "t": 6.267,
  "hold": "end",
  "tone": "hot",
  "text": "そこから火は、脳全体へ燃え広がります。"
 },
 {
  "id": "slowmo2_00",
  "seg": "slowmo2",
  "t": 0.0,
  "hold": "start",
  "tone": "normal",
  "text": "別のバーストでも見てみましょう。"
 },
 {
  "id": "slowmo2_01",
  "seg": "slowmo2",
  "t": 0.733,
  "hold": "end",
  "tone": "drama",
  "text": "やはり、しょっかくようの同じ細胞たちから点火しています。"
 },
 {
  "id": "slowmo2_02",
  "seg": "slowmo2",
  "t": 3.533,
  "hold": "end",
  "tone": "calm",
  "text": "ただし、これは神経伝達物質の仮定のひとつでの結果です。文献と矛盾しないほかの三つの仮定では、この細胞たちは常に発火して脳を駆動し、バーストは視覚系から始まります。"
 },
 {
  "id": "lead_00",
  "seg": "lead",
  "t": 0.0,
  "hold": "end",
  "tone": "normal",
  "text": "二十九回のバーストで、この細胞たちは脳全体より、三十から四十五ミリ秒早く発火が高まっていました。"
 },
 {
  "id": "lead_01",
  "seg": "lead",
  "t": 4.2,
  "hold": "end",
  "tone": "drama",
  "text": "さらに、配線図だけから計算した最も強い興奮性のループ、先頭モードも、この細胞たちを含む、しょっかくようのループに集中していました。"
 },
 {
  "id": "round3_00",
  "seg": "round3",
  "t": 0.0,
  "hold": "end",
  "tone": "hot",
  "text": "ラウンド、スリー。点火役を黙らせたら、バーストは減るのか。"
 },
 {
  "id": "silence_00",
  "seg": "silence",
  "t": 0.0,
  "hold": "end",
  "tone": "normal",
  "text": "点火役の三十個だけを、発火できないようにしてみます。"
 },
 {
  "id": "silence_01",
  "seg": "silence",
  "t": 4.0,
  "hold": "end",
  "tone": "normal",
  "text": "この例では、バーストは三十六回から十五回に。ランダムな三十個では二十三回でしたが、これは一回だけの例です。"
 },
 {
  "id": "silence_02",
  "seg": "silence",
  "t": 8.0,
  "hold": "end",
  "tone": "hot",
  "text": "くり返し確かめると、脳のわずか、れいてんれいにパーセント、三十個を黙らせるだけで、バーストはおよそ三分の一になりました。シナプスを二倍にしたときです。"
 },
 {
  "id": "silence_03",
  "seg": "silence",
  "t": 13.0,
  "hold": "end",
  "tone": "normal",
  "text": "ランダムな三十個を黙らせても、ほとんど減りません。"
 },
 {
  "id": "silence_04",
  "seg": "silence",
  "t": 18.0,
  "hold": "end",
  "tone": "normal",
  "text": "四通りの伝達物質の仮定でも確かめました。しょっかくようのアセチルコリン性局所ニューロン、百十一個を黙らせると、バーストは、れいてんにーご倍から、レイテンヨンナナ倍に減り、シナプス数をそろえた別の細胞より強く効きました。ただし、同じループの投射ニューロンなど、最も強く駆動する細胞を黙らせると、さらに減ります。鍵は一種類の細胞ではなく、しょっかくようの興奮性ループ全体だと考えられます。"
 },
 {
  "id": "round4_00",
  "seg": "round4",
  "t": 0.0,
  "hold": "end",
  "tone": "hot",
  "text": "ラウンド、フォー。本物のハエのしょっかくようにも、その気配はあるのか。"
 },
 {
  "id": "real_00",
  "seg": "real",
  "t": 0.0,
  "hold": "end",
  "tone": "normal",
  "text": "本物のハエ二十匹の、なにもしていないときの脳活動です。カルシウムイメージングで記録されました。"
 },
 {
  "id": "real_01",
  "seg": "real",
  "t": 3.8,
  "hold": "end",
  "tone": "drama",
  "text": "七十四の脳領域のうち、しょっかくようのゆらぎは最もゆっくりな部類でした。右はいちばん、左は四番目です。"
 },
 {
  "id": "real_02",
  "seg": "real",
  "t": 8.0,
  "hold": "end",
  "tone": "joy",
  "text": "二十匹中十八匹で、しょっかくようは、ほかの領域よりゆっくりゆらいでいました。"
 },
 {
  "id": "real_03",
  "seg": "real",
  "t": 11.6,
  "hold": "end",
  "tone": "calm",
  "text": "強い自己増幅ループがあると、活動はゆっくりゆらぎます。モデルの予測と合う手がかりですが、まだ証明ではありません。"
 },
 {
  "id": "verdict_00",
  "seg": "verdict",
  "t": 0.0,
  "hold": "end",
  "tone": "hot",
  "text": "判定は、引き分け。培養神経でもハエの脳のモデルでも、よく発火する場所ではなく、強く結びついたループが、自発活動のかなめでした。"
 },
 {
  "id": "summary_00",
  "seg": "summary",
  "t": 0.0,
  "hold": "end",
  "tone": "normal",
  "text": "まとめです。"
 },
 {
  "id": "summary_01",
  "seg": "summary",
  "t": 0.8,
  "hold": "end",
  "tone": "drama",
  "text": "培養神経のバーストは、いちばんよく発火する場所ではなく、ネットワークで最も強く結びついたまとまりから点火していました。"
 },
 {
  "id": "summary_02",
  "seg": "summary",
  "t": 6.0,
  "hold": "end",
  "tone": "drama",
  "text": "ハエの脳では、そのかなめは、しょっかくようの興奮性ループだと予測されます。本物のハエでこの細胞たちを黙らせ、自発バーストが減るか。それを確かめるのが次の一歩です。"
 }
]
